# Deployment credentials for `npm run upload:ios` and `npm run upload:android`.
# Copy this file to `.env` and fill it in.  `.env` is git-ignored — never commit it.
#
# Vars are grouped by SCOPE:
#   • ACCOUNT-LEVEL — tied to your Apple developer account. The SAME value works
#     for every app you ship, so you can copy these straight from another app's
#     .env (e.g. a sibling project).
#   • APP-LEVEL — unique to THIS app. Do NOT copy from another app; generate new.

# ============================================================================
# ACCOUNT-LEVEL — copy verbatim across all your apps
# ============================================================================

# Apple App Store Connect API key. ONE key authenticates uploads for your whole
# account. Create at https://appstoreconnect.apple.com/access/integrations/api
APPLE_API_KEY_ID=YOUR_KEY_ID_HERE
APPLE_API_ISSUER_ID=YOUR_ISSUER_ID_HERE

# Path to the downloaded key file (named AuthKey_<APPLE_API_KEY_ID>.p8).
# It's the SAME file for every app — point them all at the one .p8.
APPLE_API_KEY_PATH=~/.private_keys/AuthKey_YOUR_KEY_ID.p8

# Apple Developer Team ID — the same for every app under your team.
# Find at https://developer.apple.com/account (Membership).
# Also set this in app.json → expo.ios.appleTeamId.
APPLE_TEAM_ID=YOUR_TEAM_ID_HERE

# ============================================================================
# APP-LEVEL — unique to this app; generate fresh, do NOT copy from another app
# ============================================================================

# Android upload keystore (.jks) that signs the release .aab. Each app should
# have its OWN upload key — the default path below is namespaced by the app slug
# so two apps never collide on one keystore. Back up the keystore + passwords
# somewhere safe — losing the upload key means you can't ship updates under it
# (recoverable only via Google Play support).
#
# Generate it ONE of two ways:
#
#   (a) AUTOMATIC (recommended) — leave the two passwords below EMPTY and run
#       `npm run upload:android` (or `npm run setup:android`). If no keystore
#       exists at ANDROID_KEYSTORE_PATH, the script generates one with random
#       passwords and writes ANDROID_UPLOAD_STORE_PASSWORD /
#       ANDROID_UPLOAD_KEY_PASSWORD back here.
#
#   (b) MANUAL — create it yourself, then paste the passwords below. Replace
#       <app-slug> with your app.json expo.slug and <App Name> with expo.name:
#       keytool -genkeypair -v -storetype JKS \
#         -keystore ~/.private_keys/android/<app-slug>-upload-keystore.jks \
#         -keyalg RSA -keysize 2048 -validity 10000 -alias upload \
#         -storepass <STORE_PW> -keypass <KEY_PW> \
#         -dname "CN=<App Name>, OU=Development, O=<App Name>, L=City, ST=State, C=US"
#
# Leaving ANDROID_KEYSTORE_PATH empty defaults to
#   ~/.private_keys/android/<app-slug>-upload-keystore.jks
# The setup/upload scripts write the resolved path back here on first run.
ANDROID_KEYSTORE_PATH=
ANDROID_UPLOAD_STORE_PASSWORD=
ANDROID_UPLOAD_KEY_PASSWORD=

# Android package name (applicationId). Must match EXACTLY the package name you
# registered when creating the app in Google Play Console (e.g. com.example.myapp),
# and can never change once published. Leave blank — `upload:android` prompts for
# it on the first run and writes it here for future builds.
ANDROID_PACKAGE_NAME=

# Note: uploading to Google Play is MANUAL by default — `upload:android` builds
# the signed .aab and prints upload instructions for the Play Console web UI.
# (No Google service-account key is required.)
